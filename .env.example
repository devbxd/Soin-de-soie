# Copy this file to .env, fill in real values, and never commit .env (it's in .gitignore).
# On Vercel these same names go into Project Settings → Environment Variables instead.

# Neon connection string (Neon dashboard → your project → Connection Details)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string, used to sign admin session cookies (any random 32+ char string)
SESSION_SECRET=

# Generated from your chosen admin password — see README-DEPLOY.md for the one-time command
ADMIN_PASSWORD_HASH=

# Resend (resend.com) — for order notification emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
OWNER_NOTIFY_EMAIL=

# The business WhatsApp number, international format, digits only (no "+")
WHATSAPP_NUMBER=9613052374
